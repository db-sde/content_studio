# Same Neon connection string as content_studio/.env's DATABASE_URL — this service shares that
# database (new pipeline_* tables only), it does not provision its own Postgres.
DATABASE_URL=

# Local Redis (Celery broker + result backend). `redis-server` via Homebrew, or `docker compose up`.
REDIS_URL=redis://localhost:6379/0

# Shared secret Node's imagePipelineClient.js sends as `X-Pipeline-Key` — the browser never sees
# this. Generate any long random string.
PIPELINE_API_KEY=

# 'mock' runs the full pipeline with a deterministic placeholder image and zero external API
# calls/cost — useful for local dev and CI. 'live' uses the real provider configured below.
PROVIDER_MODE=mock

# Which real provider to use when PROVIDER_MODE=live. Swappable without code changes.
IMAGE_PROVIDER=flux

# fal.ai key — https://fal.ai/dashboard/keys. Only required when PROVIDER_MODE=live and
# IMAGE_PROVIDER=flux.
FAL_KEY=

# Powers the Prompt Generator's LLM call (Python Anthropic SDK) — get one from
# https://console.anthropic.com. Separate from content_studio's own ANTHROPIC_API_KEY since this
# is a separate process/deployment, even though it may be the same underlying account/key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# 'local' writes to STORAGE_LOCAL_DIR and serves files via this service's own /media route — zero
# cloud setup needed to get started. Switch to 'r2' once a Cloudflare R2 bucket exists (recommended
# for production: free at this image volume, and R2 never charges egress).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./media
STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:8001/media

# Cloudflare R2 (S3-compatible) — only required when STORAGE_BACKEND=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

PORT=8001
