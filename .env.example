# Anthropic (Claude) — powers field generation ("the Writer")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Used only for seo_title/meta_description (short, mechanical, character-capped) — not narrative fields.
ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5

# OpenAI (GPT) — powers evaluation ("the Editorial Director")
# Verify this model name against your current OpenAI account/catalog before relying on it.
# To cut evaluation cost ~16x, try OPENAI_MODEL=gpt-4o-mini — validate scoring quality on a sample
# of real fields first (compare scores/feedback against gpt-4o) before relying on it in production.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Backend server
PORT=4000

# Neon (hosted Postgres) connection string — Neon dashboard > your project > Connection Details.
# Must include ?sslmode=require. The server will not start without this set.
DATABASE_URL=

# Minimum GPT overall score (0-10) to accept a Claude draft without an improve pass
EDITORIAL_SCORE_THRESHOLD=7.5

# Approximate USD->INR rate for the ₹ cost estimates — drifts with the market, update periodically
USD_TO_INR_RATE=96

# WordPress — used only by the Admin's "Publish to WordPress" action (server/integrations/wordpressClient.js).
# Leave blank until ready to test; the publish endpoint returns a clear error naming which var is missing
# rather than silently failing.
# No trailing slash, e.g. https://degreebaba.com
WORDPRESS_SITE_URL=
# WP Admin > Users > your profile > Application Passwords > add a new one. Use that, never your real login password.
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=
# REST base slug per page type (hits wp-json/wp/v2/<slug>) — adjust to match your site's actual custom post type slugs.
WORDPRESS_POST_TYPE_UNIVERSITY=universities
WORDPRESS_POST_TYPE_COURSE=courses
WORDPRESS_POST_TYPE_SPECIALIZATION=specializations

# image_pipeline/ — the separate Python image-generation service (server/integrations/
# imagePipelineClient.js). One shared .env for the whole repo (this file) — image_pipeline reads
# it too (image_pipeline/app/core/config.py resolves it by absolute path), so DATABASE_URL and
# ANTHROPIC_API_KEY above are reused as-is; only the vars below are specific to that service.
IMAGE_PIPELINE_URL=http://localhost:8001
# Shared secret both sides check against each other — generate any long random string.
IMAGE_PIPELINE_API_KEY=

# 'mock' runs the full pipeline with a deterministic placeholder image and zero external API
# calls/cost — useful for local dev and CI. 'live' uses the real provider configured below.
PROVIDER_MODE=mock
# Which real provider to use when PROVIDER_MODE=live. Swappable without code changes.
IMAGE_PROVIDER=flux
# fal.ai key — https://fal.ai/dashboard/keys. Only required when PROVIDER_MODE=live and
# IMAGE_PROVIDER=flux.
FAL_KEY=
# Powers the Prompt Generator's LLM call. Separate from ANTHROPIC_MODEL above on purpose — the two
# services use different Claude models for different jobs, so they can't share one env var name.
IMAGE_PIPELINE_ANTHROPIC_MODEL=claude-opus-5

# 'cloudinary' is the default and production choice — publicly reachable out of the box (needed
# so a generated image's URL, once embedded in an approved draft's JSON, is actually loadable when
# that JSON gets published to WordPress — a separate, publicly-hosted site). 'local' writes to a
# local media/ dir and serves files via this service's own /media route instead — zero cloud setup,
# but only correct for single-machine local dev/testing (a real WordPress site can't reach
# localhost). 'r2' (Cloudflare) is a third option, kept for parity with the same StorageBackend
# interface. STORAGE_LOCAL_DIR is deliberately not set here — the code computes a correct absolute
# default; only add it if actually overriding that.
STORAGE_BACKEND=cloudinary
STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:8001/media

# Cloudinary — https://console.cloudinary.com (Dashboard shows all three). Only required when
# STORAGE_BACKEND=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (S3-compatible) — only required when STORAGE_BACKEND=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
